---
const features = [
	{
		tag: "picker",
		title: "Click any element",
		desc: "Inspect all CSS rules affecting an element — across media queries, container queries, pseudo-states.",
	},
	{
		tag: "editor",
		title: "Live editing",
		desc: "Arrow keys nudge numbers. Color properties get a native color picker. Changes preview instantly.",
	},
	{
		tag: ":hover",
		title: "Force pseudo-states",
		desc: "Toggle :hover, :focus, or :active on any element to inspect and edit styles that only apply in those states.",
	},
	{
		tag: "viewport",
		title: "Viewport switcher",
		desc: "Simulate 375, 768, or 1024px breakpoints instantly — or enter any custom width. No browser resize needed.",
	},
	{
		tag: "--vars",
		title: "CSS custom properties",
		desc: "Browse all :root variables grouped by prefix — colors, spacing, typography. Color swatches and search included.",
	},
	{
		tag: "$vars",
		title: "SCSS $variables",
		desc: "Scan and patch $variable declarations across all .scss files. Errors route to the right panel.",
	},
	{
		tag: "history",
		title: "Session history",
		desc: "Every apply is logged as a batch. Undo the last batch or restore any previous state from the panel.",
	},
	{
		tag: "⌨",
		title: "Keyboard shortcuts",
		desc: "Alt+S toggles the overlay. Arrow keys nudge numeric values ±1, Shift ±10, Alt ±0.1.",
	},
	{
		tag: "plugins",
		title: "Multi-framework",
		desc: "Vite, Next.js, Vue, Nuxt, Astro, SvelteKit, Solid. One overlay package for all of them.",
	},
];
---

<section class="features" id="features">
	<div class="features-inner">
		<div class="section-label">Features</div>
		<h2 class="section-heading">Everything you need.<br />Nothing you don't.</h2>

		<div class="grid">
			{
				features.map((f) => (
					<div class="card">
						<span class="card-tag">{f.tag}</span>
						<h3 class="card-title">{f.title}</h3>
						<p class="card-desc">{f.desc}</p>
					</div>
				))
			}
		</div>

		<div class="formats">
			<div class="formats-label">CSS formats supported</div>
			<div class="formats-list">
				{
					[
						["Plain .css", "✅"],
						[".scss", "✅"],
						["CSS Modules", "✅"],
						["Vue <style scoped>", "✅"],
						["Tailwind", "⚠️ detected, warns"],
					].map(([name, status]) => (
						<div class="format-row">
							<span class="format-name">{name}</span>
							<span class="format-status">{status}</span>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.features {
		padding: 100px 48px;
		border-top: 1px solid var(--border);
		position: relative;
	}

	.features::before {
		content: "";
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 600px;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--purple), transparent);
	}

	.features-inner {
		max-width: 960px;
		margin: 0 auto;
	}

	.section-label {
		font-family: var(--mono);
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--purple-lt);
		margin-bottom: 16px;
	}

	.section-heading {
		font-family: var(--display);
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--text);
		line-height: 1.15;
		margin-bottom: 56px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		background: var(--border);
		border: 1px solid var(--border);
		border-radius: 12px;
		overflow: hidden;
		margin-bottom: 48px;
	}

	.card {
		background: var(--surface);
		padding: 28px 24px;
		transition: background 0.2s;
		position: relative;
	}

	.card:hover {
		background: var(--surface2);
	}

	.card::after {
		content: "";
		position: absolute;
		inset: 0;
		border: 1px solid transparent;
		border-radius: 0;
		transition: border-color 0.2s;
		pointer-events: none;
	}

	.card:hover::after {
		border-color: var(--purple-dim);
	}

	.card-tag {
		display: inline-block;
		font-family: var(--mono);
		font-size: 10px;
		color: var(--purple-lt);
		background: var(--purple-dim);
		border: 1px solid rgba(124, 58, 237, 0.2);
		padding: 2px 7px;
		border-radius: 4px;
		margin-bottom: 12px;
	}

	.card-title {
		font-family: var(--display);
		font-size: 16px;
		font-weight: 700;
		color: var(--text);
		margin-bottom: 8px;
		letter-spacing: -0.01em;
	}

	.card-desc {
		font-size: 13px;
		color: var(--text2);
		line-height: 1.6;
	}

	/* Formats table */
	.formats {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.formats-label {
		font-family: var(--mono);
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--muted);
	}

	.formats-list {
		display: flex;
		flex-direction: column;
		gap: 0;
		border: 1px solid var(--border);
		border-radius: 8px;
		overflow: hidden;
		max-width: 400px;
	}

	.format-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 8px 14px;
		border-bottom: 1px solid var(--border);
		font-size: 12px;
	}

	.format-row:last-child {
		border-bottom: none;
	}

	.format-name {
		font-family: var(--mono);
		color: var(--text2);
	}

	.format-status {
		font-size: 11px;
		color: var(--muted);
	}

	@media (max-width: 768px) {
		.features {
			padding: 64px 24px;
		}

		.grid {
			grid-template-columns: 1fr;
		}
	}

	@media (min-width: 769px) and (max-width: 1024px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
