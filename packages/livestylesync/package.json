{
	"name": "livestylesync",
	"version": "0.1.8",
	"description": "Edit styles in the browser. Changes go straight to your source files.",
	"license": "MIT",
	"type": "module",
	"exports": {
		"./overlay": {
			"import": "./dist/overlay.js",
			"types": "./dist/overlay.d.ts"
		},
		"./vite-plugin": {
			"import": "./dist/vite-plugin.js",
			"types": "./dist/vite-plugin.d.ts"
		}
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"build": "tsup src/overlay.ts src/vite-plugin.ts --format esm --dts --external vite --external ws"
	},
	"dependencies": {
		"livestylesync-overlay": "^0.1.7",
		"livestylesync-vite-plugin": "^0.1.7"
	},
	"devDependencies": {
		"@types/node": "^24.12.2",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.11"
	}
}
