{
	"name": "livestylesync-vite-plugin",
	"version": "0.1.5",
	"description": "Vite plugin for LiveStyleSync",
	"license": "MIT",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --external vite --external ws --external postcss --external postcss-scss"
	},
	"peerDependencies": {
		"vite": ">=4"
	},
	"dependencies": {
		"ws": "^8.20.1",
		"postcss": "^8.5.0",
		"postcss-scss": "^4.0.9"
	},
	"devDependencies": {
		"@types/node": "^24.12.2",
		"@types/ws": "^8.18.1",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.11"
	}
}
