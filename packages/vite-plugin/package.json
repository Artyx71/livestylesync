{
	"name": "livestylesync-vite-plugin",
	"version": "1.1.0",
	"description": "Vite plugin for LiveStyleSync",
	"license": "MIT",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --external vite"
	},
	"peerDependencies": {
		"vite": ">=4"
	},
	"dependencies": {
		"livestylesync-server-core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.12.4",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
